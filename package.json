{
  "name": "kelpie",
  "version": "0.7.3",
  "description": "A worker binary to coordinate long running jobs on salad. Works with Kelpie API",
  "main": "dist/index.js",
  "scripts": {
    "test": "rm -rf dist && npm run build && node --test dist/*.test.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "build-binary": "tsc && pkg ."
  },
  "author": "Shawn Rushefsky",
  "license": "MIT",
  "devDependencies": {
    "@types/mime-types": "3.0.1",
    "@types/node": "20.19.14",
    "@yao-pkg/pkg": "6.20.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1068.0",
    "@aws-sdk/lib-storage": "3.1068.0",
    "@saladtechnologies-oss/salad-cloud-imds-sdk": "0.9.0-alpha.5",
    "@smithy/node-http-handler": "4.7.8",
    "chokidar": "4.0.3",
    "mime-types": "3.0.1",
    "pino": "9.14.0"
  },
  "bin": {
    "kelpie": "./dist/index.js"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "picomatch": "4.0.4",
    "zod": "3.25.76"
  },
  "pkg": {
    "targets": [
      "node24-linux-x64"
    ],
    "outputPath": "bin"
  }
}
